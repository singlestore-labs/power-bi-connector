// Pure helper functions extracted from SingleStoreODBC.pq so they can be unit-tested in
// isolation. Loaded via Extension.LoadFunction, exactly like Diagnostics.pqm / OdbcConstants.pqm.
// Nothing here touches Odbc.DataSource, credentials, or I/O — all logic is deterministic.
let
    // Parse "host[:port]" into the connection-string record; default port 3306 when omitted.
    AddServerAndPort = (baseString as record, serverAddr as text) as record =>
        let
            Address = Splitter.SplitTextByDelimiter(":")(serverAddr),
            Host = Address{0},
            PortRaw = if List.Count(Address) > 1 then Address{1} else ""
        in
            if List.Count(Address) > 2 or Host = ""
            then
                error "Invalid server address provided"
            else
                let
                    connStringHost = Record.AddField(baseString, "Server", Host)
                in
                    if PortRaw = ""
                    then
                        Record.AddField(connStringHost, "Port", 3306)
                    else
                        let
                            Port = Int32.From(PortRaw)
                        in
                            if Port = null
                            then
                                error "Invalid port value provided"
                            else
                                Record.AddField(connStringHost, "Port", Port),

    // Size reported for SingleStore types that have no fixed ODBC size (treated as 65535-char).
    MaxCharLength = 65535,
    CharOctetLength = 3,

    // Shorten an ODBC type name (drop the "(N)"/" " suffix), preserving a trailing "unsigned".
    RenameOdbcType = (t) =>
        let
            unsigned = Text.Contains(t, "unsigned"),
            typeShortened = List.First(Text.SplitAny(t, "( ")),
            resultType = if unsigned then Text.Combine({typeShortened, "unsigned"}, " ") else typeShortened
        in
            resultType,

    // True for SingleStore types whose reported size must be inflated.
    OdbcTypeNeedsSizeFix = (t) =>
        if (t = "json" or t = "geographypoint" or t = "geography") then
            true
        else false,

    // Rename a SQLColumns row's TYPE_NAME and, for size-less types, inflate its size fields.
    FixOdbcColumnRow = (row) =>
        let
            rowFixedTypeName = Record.TransformFields(row, {{"TYPE_NAME", (value) as text => RenameOdbcType(value)}}),
            rowFixedSizes = if (OdbcTypeNeedsSizeFix(rowFixedTypeName[TYPE_NAME])) then
                Record.TransformFields(rowFixedTypeName, {
                    {"COLUMN_SIZE", (value) => MaxCharLength},
                    {"BUFFER_LENGTH", (value) => MaxCharLength * CharOctetLength + 1}, // Terminal symbol
                    {"CHAR_OCTET_LENGTH", (value) => CharOctetLength}
                }) else rowFixedTypeName
        in
            rowFixedSizes,

    // Value.NativeQuery errors on a trailing ";", so strip trailing semicolons before use.
    StripTrailingSemicolons = (query) => Text.TrimEnd(query, ";"),

    // SSL precedence: an explicit UseSSL option wins; otherwise the credential's EncryptConnection
    // (which defaults to on when unset).
    ResolveSsl = (optionsUseSSL, credentialEncrypt) =>
        if (optionsUseSSL <> null) then
            optionsUseSSL
        else
            if (credentialEncrypt = null or credentialEncrypt = true) then
                true
            else
                false,

    // Map the active credential (from Extension.CurrentCredential()) to the ODBC
    // CredentialConnectionString record. Pure: takes the credential record, returns the
    // connection-string fields. Odbc.DataSource handles UsernamePassword automatically, but it
    // is spelled out here so every supported auth kind lives in one testable place.
    //   UsernamePassword -> UID/PWD (basic auth)
    //   Windows          -> Trusted_Connection (Windows/Kerberos)
    //   Key              -> JWT= only (SingleStore JWT: user pastes an access token)
    //   OAuth            -> JWT= only (SingleStore JWT: token obtained via the OAuth sign-in flow)
    // Key and OAuth are the same injection (dedicated JWT= property, no UID — the server resolves
    // the username from the token's claims); they differ only in how the token is acquired.
    BuildCredentialConnectionString = (credential as record) as record =>
        let
            authKind = credential[AuthenticationKind]?
        in
            if authKind = "UsernamePassword" then
                [ UID = credential[Username], PWD = credential[Password] ]
            else if authKind = "Windows" then
                [ Trusted_Connection = "Yes" ]
            else if authKind = "Key" then
                [ JWT = credential[Key] ]
            else if authKind = "OAuth" then
                [ JWT = credential[access_token] ]
            else
                error Error.Record("Error", "Unhandled authentication kind: " & authKind),

    // SingleStore JWT users are created REQUIRE SSL, so the token-based auth paths (Key and OAuth)
    // mandate encryption regardless of the UseSSL option or the credential's EncryptConnection.
    TokenAuthRequiresSsl = (authKind) as logical => authKind = "Key" or authKind = "OAuth",

    // --- OAuth / OIDC PKCE helpers ---

    Base64UrlEncode = (data as binary) as text =>
        let
            base64 = Binary.ToText(data, BinaryEncoding.Base64),
            noPadding = Text.BeforeDelimiter(base64, "="),
            urlSafe = Text.Replace(Text.Replace(noPadding, "+", "-"), "/", "_")
        in
            urlSafe,

    // Extract the code / state / error query parameters from the OAuth redirect callback URI.
    ParseAuthorizeCallback = (callbackUri as text) as record =>
        let
            query = Uri.Parts(callbackUri)[Query]
        in
            [
                code = Record.FieldOrDefault(query, "code", null),
                state = Record.FieldOrDefault(query, "state", null),
                error = Record.FieldOrDefault(query, "error", null)
            ],

    // Form body for the token endpoint. Used for both the authorization_code and refresh_token grants.
    BuildTokenRequestQuery = (clientId as text, redirectUri as text, grantType as text, code as text, optional verifier as nullable text) as record =>
        let
            base = [ client_id = clientId, grant_type = grantType ]
        in
            if grantType = "authorization_code" then
                base & [ redirect_uri = redirectUri, code = code, code_verifier = verifier ]
            else
                base & [ refresh_token = code ],

    // Authorize, token and (optional) revocation endpoints from the OIDC discovery document.
    ParseOidcDiscovery = (doc as record) as record =>
        let
            authorize = Record.FieldOrDefault(doc, "authorization_endpoint", null),
            token = Record.FieldOrDefault(doc, "token_endpoint", null),
            revocation = Record.FieldOrDefault(doc, "revocation_endpoint", null)
        in
            if authorize = null or token = null then
                error Error.Record(
                    "Error",
                    "OIDC discovery document missing authorization_endpoint or token_endpoint"
                )
            else
                [
                    authorize = authorize,
                    token = token,
                    revocation = revocation
                ],

    // Turn a parsed token-endpoint response into the credential record Power BI persists.
    SelectTokenFields = (body as record) as record =>
        if Record.HasFields(body, "error") then
            error Error.Record(
                body[error],
                body[error_description]?,
                body
            )
        else if body[access_token]? = null then
            error Error.Record("Error", "Token endpoint response did not include an access_token", body)
        else
            body,

    // Keep the current refresh_token when the IdP does not return a new one on refresh.
    PreserveRefreshToken = (response as record, refreshToken as text) as record =>
        if response[refresh_token]? <> null then
            response
        else
            response & [ refresh_token = refreshToken ]
in
    [
        AddServerAndPort = AddServerAndPort,
        RenameOdbcType = RenameOdbcType,
        OdbcTypeNeedsSizeFix = OdbcTypeNeedsSizeFix,
        FixOdbcColumnRow = FixOdbcColumnRow,
        StripTrailingSemicolons = StripTrailingSemicolons,
        ResolveSsl = ResolveSsl,
        BuildCredentialConnectionString = BuildCredentialConnectionString,
        TokenAuthRequiresSsl = TokenAuthRequiresSsl,
        Base64UrlEncode = Base64UrlEncode,
        ParseAuthorizeCallback = ParseAuthorizeCallback,
        BuildTokenRequestQuery = BuildTokenRequestQuery,
        ParseOidcDiscovery = ParseOidcDiscovery,
        SelectTokenFields = SelectTokenFields,
        PreserveRefreshToken = PreserveRefreshToken
    ]
